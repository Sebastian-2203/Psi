# Copy to .env.local and fill in. Never commit real values.

# Supabase (local: values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-anon-key

# Server only. Bypasses RLS; used only by the allowlisted admin client.
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# Postgres connection for the app login role, via the pooler (ADR-019).
DATABASE_URL=postgresql://app_user:replace-me@127.0.0.1:54322/postgres

# Base domain for tenant host resolution (e.g. <tenant>.localhost in dev).
APP_BASE_DOMAIN=localhost

NODE_ENV=development
