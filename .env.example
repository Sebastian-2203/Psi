# Copy to .env.local and fill in. Never commit real values.
# Local values: `pnpm exec supabase status -o env` after `pnpm db:start` (README "Local database").

# Supabase (local: API_URL and PUBLISHABLE_KEY from `supabase status`; well-known demo values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-publishable-key

# Server only. Auth admin API key (local: SECRET_KEY). Only the allowlisted admin path uses it.
SUPABASE_SERVICE_ROLE_KEY=replace-me-secret-key

# Password of the `app_server` DB login role (ADR-019). NOT in migrations: set locally with
# `pnpm db:app-password` (also run by `pnpm db:reset`). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
APP_DB_PASSWORD=replace-me-24-plus-chars

# Postgres connection for the app server, as `app_server` (never postgres/service_role).
# Local: direct to 54322. Hosted: transaction pooler, user `app_server.<project-ref>`, port 6543.
DATABASE_URL=postgresql://app_server:replace-me-24-plus-chars@127.0.0.1:54322/postgres

# Base domain for tenant host resolution (seeded hosts: demo-a.localhost, demo-b.localhost).
APP_BASE_DOMAIN=localhost

# App-sent emails (invitations, MFA-reset notices). LOCAL ONLY: Mailpit of the Supabase CLI
# stack (`supabase status` MAILPIT_URL). Unset in production until a mail provider is approved.
MAIL_DEV_HTTP_URL=http://127.0.0.1:54324

# Session activity cookie HMAC key (idle timeout, SECURITY.md §3.5). >= 32 random chars,
# different per environment; never commit a real one. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_ACTIVITY_SECRET=replace-me-32-plus-random-characters-000

# Client IP source for rate limits and audit (VERIFY PER DEPLOYMENT, SECURITY.md §14 P1-03).
# Unset = `vercel` on Vercel (VERIFY: x-vercel-forwarded-for / x-real-ip set by the edge);
# REQUIRED when NODE_ENV=production off Vercel (startup fails otherwise, P1-21); unset in
# development/test = `xff` with TRUSTED_PROXY_HOPS proxies in front that APPEND to X-Forwarded-For.
# `none` disables IP-based limits (per-subject limits still apply).
# TRUSTED_PROXY=xff
# TRUSTED_PROXY_HOPS=1

# PAT-06: days before the age of majority in which the care team is notified (default 60).
# MAJORITY_NOTICE_DAYS=60

NODE_ENV=development
