# Copy to .env.local and fill in. Never commit real values.
# Local values: `pnpm exec supabase status -o env` after `pnpm db:start` (README "Local database").

# Supabase (local: API_URL and PUBLISHABLE_KEY from `supabase status`; well-known demo values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-publishable-key

# Server only. Auth admin API key (local: SECRET_KEY). Only the allowlisted admin path uses it.
SUPABASE_SERVICE_ROLE_KEY=replace-me-secret-key

# Password of the `app_server` DB login role (ADR-019). NOT in migrations: set locally with
# `pnpm db:app-password` (also run by `pnpm db:reset`). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
APP_DB_PASSWORD=replace-me-24-plus-chars

# Postgres connection for the app server, as `app_server` (never postgres/service_role).
# Local: direct to 54322. Hosted: transaction pooler, user `app_server.<project-ref>`, port 6543.
DATABASE_URL=postgresql://app_server:replace-me-24-plus-chars@127.0.0.1:54322/postgres

# Base domain for tenant host resolution (seeded hosts: demo-a.localhost, demo-b.localhost).
APP_BASE_DOMAIN=localhost

NODE_ENV=development
